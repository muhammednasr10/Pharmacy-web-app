# Copy to .env for local development (never commit .env)
#
# Vercel (Production + Preview — required for every deploy):
#   Project → Settings → Environment Variables
#   Add both required variables and enable scopes: Production ✓  Preview ✓
#   Values: Supabase → Settings → API → Project URL + anon public key
#   Redeploy after saving (env vars apply on the next build only).
#
# Preview deployments (PR / branch) use the same Supabase vars unless you
# create a separate Supabase project for staging.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# One-time catalog seed only (pick one method — never commit secrets)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
# SEED_ADMIN_EMAIL=admin@your-pharmacy.com
# SEED_ADMIN_PASSWORD=your-super-admin-password

# Optional — Sentry error monitoring (production)
# Create project at https://sentry.io → Settings → Client Keys (DSN)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_DEV=false
# VITE_APP_VERSION=1.0.0

# Optional — direct Postgres access for `npm run sql:apply` (never expose in the browser)
# Supabase → Project Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# SUPABASE_JWT_SECRET=your-jwt-secret-from-api-settings

# VITE_SUBSCRIPTION_NOTIFY_WEBHOOK_URL=
# VITE_SUPER_ADMIN_EMAIL=
# VITE_EXPIRY_NOTIFY_WEBHOOK_URL=
# VITE_AUTO_OPEN_ADMIN_WHATSAPP=false
# VITE_AUTO_OPEN_EXPIRY_WHATSAPP=false
