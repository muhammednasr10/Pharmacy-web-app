# Copy to .env for local development (never commit .env)
#
# Vercel (Production + Preview — required for every deploy):
#   Project → Settings → Environment Variables
#   Add both required variables and enable scopes: Production ✓  Preview ✓
#   Values: Supabase → Settings → API → Project URL + anon public key
#   Redeploy after saving (env vars apply on the next build only).
#
# Preview deployments (PR / branch) use the same Supabase vars unless you
# create a separate Supabase project for staging.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional notifications (safe to leave empty on Preview)
# VITE_SUBSCRIPTION_NOTIFY_WEBHOOK_URL=
# VITE_SUPER_ADMIN_EMAIL=
# VITE_EXPIRY_NOTIFY_WEBHOOK_URL=
# VITE_AUTO_OPEN_ADMIN_WHATSAPP=false
# VITE_AUTO_OPEN_EXPIRY_WHATSAPP=false
