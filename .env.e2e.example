# Copy to .env.e2e (never commit real credentials)
# Requires a running Supabase project with the same vars as .env

# App URL (Playwright starts `npm run dev` unless E2E_SKIP_WEBSERVER=1)
E2E_BASE_URL=http://localhost:5173

# Test pharmacy account (manager or cashier with POS + returns permissions)
# Branches / Subscription E2E: use org admin (pharmacy_admin) with branches + settings access.
# CRM E2E requires a tier/account with Customers (CRM) page enabled — not basic-only gating.
# Inventory / HR E2E require inventory and staff (HR) pages enabled for the test account.
E2E_LOGIN_EMAIL=manager@your-pharmacy.com
E2E_LOGIN_PASSWORD=your-password

# Barcode of an in-stock medicine in the test pharmacy branch (required for POS / inventory E2E)
E2E_TEST_BARCODE=6221234567890

# Optional: skip auto-start dev server if already running
# E2E_SKIP_WEBSERVER=1

# Optional: enable Playwright job in GitHub Actions (repo variable E2E_CI_ENABLED=true)
# Set the same values as GitHub Actions secrets when running E2E against staging.

# Optional: browser locale (default ar-EG)
# E2E_LOCALE=ar-EG
