# Copy to .env.e2e (never commit real credentials)
# Requires a running Supabase project with the same vars as .env

# App URL (Playwright starts `npm run dev` unless E2E_SKIP_WEBSERVER=1)
E2E_BASE_URL=http://localhost:5173

# Test pharmacy account — MUST be real credentials (not these placeholders).
# Create a dedicated test user in the app: Employees → login accounts, or use your manager account.
E2E_LOGIN_EMAIL=REPLACE_WITH_REAL_EMAIL
E2E_LOGIN_PASSWORD=REPLACE_WITH_REAL_PASSWORD

# Barcode of an in-stock medicine in that account's branch (Inventory page → copy barcode, qty > 0)
E2E_TEST_BARCODE=REPLACE_WITH_REAL_BARCODE

# Optional: skip auto-start dev server if already running
# E2E_SKIP_WEBSERVER=1

# Optional: enable Playwright job in GitHub Actions (repo variable E2E_CI_ENABLED=true)
# Set the same values as GitHub Actions secrets when running E2E against staging.

# Optional: browser locale (default ar-EG)
# E2E_LOCALE=ar-EG
